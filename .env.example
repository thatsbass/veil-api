# ============================================================
# Veil — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne jamais committer .env dans git.
# ============================================================

# ------------------------------------------------------------
# Serveur
# ------------------------------------------------------------
PORT=8080
# development | production (active console logs vs JSON logs)
ENV=development

# ------------------------------------------------------------
# Base de données PostgreSQL
# Supabase en prod : postgresql://user:pass@host:5432/db?sslmode=require
# Docker local   : postgres://veil:veil@localhost:5432/veil?sslmode=disable
# ------------------------------------------------------------
DATABASE_URL=postgres://veil:veil@localhost:5432/veil?sslmode=disable

# ------------------------------------------------------------
# Redis
# Upstash en prod : rediss://default:token@host:port
# Docker local    : redis://localhost:6379
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Providers LLM — clés secrètes, jamais en git
# ------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Stripe — utiliser les clés sk_test_ en développement
# STRIPE_WEBHOOK_SECRET : généré via `stripe listen --forward-to localhost:8080/webhooks/stripe`
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Sécurité — générer avec : openssl rand -hex 32
# API_KEY_SECRET : sel utilisé pour le hachage des clés API
# JWT_SECRET     : signature des tokens dashboard
# ------------------------------------------------------------
API_KEY_SECRET=change-me-32-bytes-hex-openssl-rand-hex-32
JWT_SECRET=change-me-32-bytes-hex-openssl-rand-hex-32
